# BSD API (obrigatório)
# Token para acessar a API de dados esportivos BSD
BSD_TOKEN=

# OpenRouter API (obrigatório para o chat)
# Chave da API OpenRouter para o agente analista
OPENROUTER_API_KEY=

# Upstash Redis (opcional, para cache)
# URL e Token do Redis para cache de requisições à BSD
KV_REST_API_URL=
KV_REST_API_TOKEN=
